JWT_SECRET=replace-with-a-strong-secret
OPENAI_API_KEY=your-openai-api-key-here
# Optional: use a different vision-capable model.
OPENAI_VISION_MODEL=gpt-4o

# Customer accounts (Firebase Authentication)
FIREBASE_PROJECT_ID=hardware-store-2c14a
# Absolute path to the private Admin SDK JSON, kept outside this repository.
# On Render, upload it as a secret file and use /etc/secrets/firebase-admin.json.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-admin.json
