JWT_SECRET=replace-with-a-strong-secret
OPENAI_API_KEY=your-openai-api-key-here
# Optional: use a different vision-capable model.
OPENAI_VISION_MODEL=gpt-4o

# Customer accounts (Firebase Authentication)
FIREBASE_PROJECT_ID=hardware-store-2c14a
# Absolute path to the private Admin SDK JSON, kept outside this repository.
# On Render, upload it as a secret file and use /etc/secrets/firebase-admin.json.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-admin.json

# Private ScanSpace originals (Supabase Storage, server-only credentials)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=scanspace
# Total allowance across account scans, not a per-file limit. Free plan: 1 GB.
SCANSPACE_TOTAL_STORAGE_BYTES=1000000000
# Optional writable temporary upload directory. Originals are kept in Supabase.
# SCANSPACE_TEMP_DIR=/tmp/hardware-store-scanspace
